---
interface Props { kind: 'rate' | 'reliability' | 'ai'; }
const {kind} = Astro.props;
---
{kind === 'rate' && <svg viewBox="0 0 440 260" role="img" aria-label="Concept: three clients share an admission gate and a bounded service">
  <g fill="none" stroke="currentColor" stroke-width="1.5">
    <path d="M90 65H142Q158 65 158 82V178Q158 195 142 195H90M90 130H208M158 82V112Q158 130 180 130H208M158 178V148Q158 130 180 130" opacity=".45"/>
    <rect x="208" y="93" width="84" height="74" rx="8"/><path d="M292 130H340"/>
    <rect x="340" y="93" width="66" height="74" rx="8"/>
    {[65,130,195].map((y,i)=><g><rect x="34" y={y-18} width="56" height="36" rx="5"/><text x="62" y={y+4} text-anchor="middle" fill="currentColor" stroke="none" font-size="12">0{i+1}</text></g>)}
  </g>
  <g fill="currentColor" font-size="11" text-anchor="middle" font-family="monospace"><text x="250" y="126">ADMIT</text><text x="250" y="143">/ DEFER</text><text x="373" y="135">WORK</text><text x="62" y="238">CLIENTS</text><text x="250" y="205">ATOMIC QUOTA</text><text x="373" y="205">SERVICE</text></g>
  <g fill="#f1785e"><circle cx="120" cy="65" r="5"/><circle cx="181" cy="130" r="5"/><circle cx="319" cy="130" r="5"/></g>
</svg>}
{kind === 'reliability' && <svg viewBox="0 0 440 260" role="img" aria-label="Concept: live events and restart events converge into a shared recovery path">
  <g fill="none" stroke="currentColor" stroke-width="1.5"><rect x="30" y="52" width="118" height="50" rx="5"/><rect x="30" y="158" width="118" height="50" rx="5"/><path d="M148 77H180Q196 77 196 95V165Q196 183 180 183H148M196 130H248M338 130H405"/><rect x="248" y="93" width="90" height="74" rx="6"/><circle cx="405" cy="130" r="8"/></g>
  <g fill="currentColor" font-size="11" text-anchor="middle" font-family="monospace"><text x="89" y="82">LIVE EVENT</text><text x="89" y="188">RESTART</text><text x="293" y="126">SHARED</text><text x="293" y="143">RECOVERY</text><text x="293" y="211">ONE PATH</text></g><circle cx="222" cy="130" r="5" fill="#f1785e"/>
</svg>}
{kind === 'ai' && <svg viewBox="0 0 440 260" role="img" aria-label="Concept: requirements, design, code and validation form a skill-guided development pipeline">
  <g fill="none" stroke="currentColor" stroke-width="1.5"><path d="M50 130H390M370 130V205H70V158" opacity=".4"/>{[22,126,230,334].map(x=><rect x={x} y="95" width="84" height="70" rx="5" fill="#e8e5f2"/>)}</g>
  <g fill="currentColor" font-size="11" text-anchor="middle" font-family="monospace"><text x="64" y="127">SPEC</text><text x="64" y="144">01</text><text x="168" y="127">DESIGN</text><text x="168" y="144">02</text><text x="272" y="127">CODE</text><text x="272" y="144">03</text><text x="376" y="127">VALIDATE</text><text x="376" y="144">04</text><text x="220" y="228">SKILLS + HUMAN REVIEW</text></g><circle cx="220" cy="205" r="5" fill="#f1785e"/>
</svg>}
