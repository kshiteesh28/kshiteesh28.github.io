---
import type { MarkdownInstance } from 'astro';
import Layout from '../../layouts/Layout.astro';
import SystemDiagram from '../../components/SystemDiagram.astro';
interface Frontmatter { title:string; subtitle:string; category:string; kind:'rate'|'reliability'|'ai'; stack:string; metric:string; metricLabel:string; }
export function getStaticPaths() {
  const posts = import.meta.glob<MarkdownInstance<Frontmatter>>('../../content/work/*.md', { eager:true });
  return Object.entries(posts).map(([path, post]) => ({ params:{slug:path.split('/').pop()!.replace('.md','')}, props:{post} }));
}
const { post } = Astro.props;
const { Content, frontmatter: f } = post as MarkdownInstance<Frontmatter>;
const base = import.meta.env.BASE_URL;
---
<Layout title={f.title + ' — Kshiteesh R Bharadwaj'} description={f.subtitle}>
  <main id="main" class="case-page wrap">
    <a class="text-link back-link" href={base + '#work'}>← Selected work</a>
    <header class="case-header"><span class="eyebrow">{f.category}</span><h1>{f.title}</h1><p>{f.subtitle}</p><span class="stack">{f.stack}</span></header>
    <div class={'case-diagram ' + f.kind}><SystemDiagram kind={f.kind}/><div><strong>{f.metric}</strong><p>{f.metricLabel}</p><span class="mono">Reported in my experience / project record</span></div></div>
    <article class="prose"><Content /></article>
    <aside class="case-contact"><h2>Have a related problem?</h2><a class="text-link" href="mailto:kshiteeshrbharadwaj@gmail.com">Let’s compare notes ↗</a></aside>
  </main>
</Layout>
