---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'Kshiteesh R Bharadwaj | Software Engineer', description = 'Software engineer with 3.5 years of experience at Nokia and Infinera, now pursuing an MCS at UIUC.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href={base + 'favicon.svg'} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(base + 'social.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="brand" href={base} aria-label="Kshiteesh Bharadwaj — home"><span>Kshiteesh R Bharadwaj</span></a>
      <nav aria-label="Main navigation">
        <a href={base + '#experience'}>Experience</a>
        <a href={base + '#projects'}>Projects</a>
        <a href={base + '#education'}>Education</a>
        <a class="nav-resume" href={base + 'resume.pdf'}>Resume (PDF) ↗</a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer wrap">
      <a class="footer-name" href={base}>Kshiteesh R Bharadwaj<span>Software Engineer · Champaign, Illinois</span></a>
      <div><a href="https://github.com/kshiteesh28">GitHub ↗</a><a href="https://linkedin.com/in/kshiteesh-bharadwaj-kb2001">LinkedIn ↗</a><a href={base + 'resume.pdf'}>Resume ↗</a></div>
      <span class="footer-note">© {new Date().getFullYear()} Kshiteesh R Bharadwaj</span>
    </footer>
  </body>
</html>
